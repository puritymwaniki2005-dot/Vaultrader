{
  "version": 2,
  "installCommand": "cd react-platform && npm install",
  "buildCommand": "cd react-platform && npm run build && node scripts/prepare-deploy.mjs",
  "outputDirectory": "react-platform/dist",
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
